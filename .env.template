# Deepstream environment variables
# Fill these in after creating your Telegram bot

# 1. Get this from @BotFather on Telegram
DEEPSTREAM_BOT_TOKEN=

# 2. Create a private channel, add bot as admin, then post a message
#    and visit: https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#    to find the chat_id
DEEPSTREAM_CHANNEL_ID=

# 3. Private Telegram channel for Pro subscribers. Create a channel, add the
#    bot as an ADMIN (it needs invite-link permissions), then grab the chat_id
#    the same way as above.
DEEPSTREAM_PRO_CHANNEL_ID=

# --- Paddle (payment provider) ------------------------------------------------
# Paddle is a Merchant of Record, so it handles global sales tax / VAT and
# international payments for you — a good fit for sellers based in India
# selling worldwide. Sign up at https://www.paddle.com and create:
#   - a Product ("Deepstream Pro") with a $29/mo recurring Price
#   - a client-side token  (Developer tools > Authentication)
#   - a notification destination for webhooks  (Developer tools > Notifications)
#
# Environment: sandbox | live
PADDLE_ENV=sandbox

# Client-side token — safe to ship to the browser (it powers Paddle.js).
PADDLE_CLIENT_TOKEN=

# The Pro recurring price id, e.g. pri_01xxxxxxxxxxxxxxxxxxxxxxxx
PADDLE_PRICE_ID=

# Notification destination secret key. Set the webhook URL to:
#   https://<your-domain>/webhooks/paddle
PADDLE_WEBHOOK_SECRET=
