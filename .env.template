# Deepstream environment variables
# Fill these in after creating your Telegram bot

# 1. Get this from @BotFather on Telegram
DEEPSTREAM_BOT_TOKEN=

# 2. Create a private channel, add bot as admin, then post a message
#    and visit: https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#    to find the chat_id
DEEPSTREAM_CHANNEL_ID=

# 3. Private Telegram channel for Pro subscribers. Create a channel, add the
#    bot as an ADMIN (it needs invite-link permissions), then grab the chat_id
#    the same way as above.
DEEPSTREAM_PRO_CHANNEL_ID=

# --- Gumroad (payment provider) ----------------------------------------------
# Gumroad is a Merchant of Record, so it handles global sales tax / VAT and
# international payments for you — a good fit for sellers based in India
# selling worldwide. Sign up at https://gumroad.com and create:
#   - a Product ("Deepstream Pro") as a membership, $29/mo recurring
#   - set the product's "Redirect URL" to your success page, e.g.
#       https://deepstreamofficial.netlify.app/success.html
#   - generate an API access token  (Settings > Advanced > API)
#   - subscribe to webhooks for resources: sale, refund, cancellation,
#     subscription_updated, subscription_ended, subscription_restarted
#       PUT https://api.gumroad.com/v2/resource_subscriptions
#       (or set the Ping URL to https://<your-domain>/webhooks/gumroad)
#
# API access token used to verify webhook sales server-side.
GUMROAD_ACCESS_TOKEN=

# The Pro membership product id, e.g. bfi_xxxxxxxxxxxxxxxxxxxxxxxx
GUMROAD_PRODUCT_ID=

# The hosted checkout URL the buy button opens, e.g.
# https://gumroad.com/l/deepstream-pro
GUMROAD_CHECKOUT_URL=
