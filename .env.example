# ---------------------------------------------------------------------------
# Deepstream environment configuration
# Copy this file to .env and fill in your real values:
#     cp .env.example .env
# .env is gitignored — never commit real credentials.
# ---------------------------------------------------------------------------

# --- Telegram -----------------------------------------------------------
# Bot token from @BotFather (e.g. 7123456789:AAE_xYz...). Anyone with this
# token can post as your bot — treat it like a password.
DEEPSTREAM_BOT_TOKEN=

# Numeric ID of the PUBLIC channel that receives the free weekly summary
# (e.g. -1001234567890). Optional but recommended.
DEEPSTREAM_CHANNEL_ID=

# Numeric ID of the PRIVATE Pro channel. The bot MUST be an admin here with
# "Invite users via link" permission, or paid customers get no invite link.
DEEPSTREAM_PRO_CHANNEL_ID=

# --- Cashfree (Payment Gateway) -----------------------------------------
# Merchant Dashboard -> Developers -> API Keys
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=

# "sandbox" for testing, "production" for live payments
CASHFREE_ENV=sandbox

# Cashfree API version (default 2023-08-01)
CASHFREE_API_VERSION=2023-08-01

# Secret shown by Cashfree after saving the webhook configuration
CASHFREE_WEBHOOK_SECRET=

# Amount and currency charged per Pro month
CASHFREE_ORDER_AMOUNT=29
CASHFREE_ORDER_CURRENCY=USD

# Base URL of the landing site (used for the Cashfree return_url)
CASHFREE_SITE_URL=https://deepstreamofficial.netlify.app

# --- Netlify (functions backend) ---
# Set the same Cashfree + Telegram vars as site environment variables in
# Netlify → Site settings → Environment variables. Storage uses Netlify Blobs.
