# Deepstream — environment template
# Copy to .env and fill in. Never commit .env.

# --- Telegram (signal delivery + Pro invite links) ---
DEEPSTREAM_BOT_TOKEN=<bot token from @BotFather>
DEEPSTREAM_CHANNEL_ID=<public channel id, e.g. -1001234567890>
DEEPSTREAM_PRO_CHANNEL_ID=<private Pro channel id — bot must be admin>

# --- Cashfree (Payment Gateway) ---
CASHFREE_ENV=sandbox                     # sandbox | production
CASHFREE_CLIENT_ID=<client id from Cashfree dashboard>
CASHFREE_CLIENT_SECRET=<client secret from Cashfree dashboard>
CASHFREE_API_VERSION=2023-08-01
CASHFREE_WEBHOOK_SECRET=<webhook secret from Cashfree dashboard>
CASHFREE_ORDER_AMOUNT=29                 # USD per Pro month
CASHFREE_ORDER_CURRENCY=USD
CASHFREE_SITE_URL=https://deepstreamofficial.netlify.app

# --- Netlify (functions backend) ---
# Set the same Cashfree + Telegram vars as site environment variables in
# Netlify → Site settings → Environment variables. Storage uses Netlify Blobs.
